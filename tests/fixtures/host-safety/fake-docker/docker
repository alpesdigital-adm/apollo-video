#!/usr/bin/env node
// A `docker` that records every invocation and answers from a scenario.
//
// This is not a mock of the deploy: the real `infra/deploy/apollo-vps.sh` runs, with
// this file first on PATH, so the assertions are about the script's actual command
// sequence and its actual reaction to what Docker says. Two kinds of invocation are
// NOT faked but delegated to real Node — the resource budget CLI and the host safety
// verdict — so the numbers and the admission decisions in these tests come from the
// same code production runs, reading the same gate.json and journal the test writes.
//
// Environment:
//   APOLLO_FAKE_DOCKER_LOG       ndjson file, one line per invocation
//   APOLLO_FAKE_DOCKER_SCENARIO  JSON describing the daemon and the behaviours
//   APOLLO_FAKE_DOCKER_STATE     JSON file mutated across invocations
//   APOLLO_FAKE_DOCKER_STATE_DIR host path that /app/ops-state maps to
//   APOLLO_FAKE_DOCKER_REPO      repository root, for the delegated scripts
const { appendFileSync, readFileSync, writeFileSync, existsSync } = require('node:fs')
const { spawnSync } = require('node:child_process')
const { join } = require('node:path')

const argv = process.argv.slice(2)
const logPath = process.env.APOLLO_FAKE_DOCKER_LOG
const scenarioPath = process.env.APOLLO_FAKE_DOCKER_SCENARIO
const statePath = process.env.APOLLO_FAKE_DOCKER_STATE
const hostStateDir = process.env.APOLLO_FAKE_DOCKER_STATE_DIR ?? ''
const repositoryRoot = process.env.APOLLO_FAKE_DOCKER_REPO ?? process.cwd()

const scenario = JSON.parse(readFileSync(scenarioPath, 'utf8'))
const state = existsSync(statePath) ? JSON.parse(readFileSync(statePath, 'utf8')) : { containers: {}, nextPid: 1000 }
if (!state.containers) state.containers = {}
if (!state.nextPid) state.nextPid = 1000

function saveState() {
  writeFileSync(statePath, JSON.stringify(state, null, 2))
}

function record(extra) {
  if (!logPath) return
  appendFileSync(logPath, `${JSON.stringify({ argv, ...extra })}\n`)
}

function exit(code, stdout = '', stderr = '') {
  if (stdout) process.stdout.write(stdout.endsWith('\n') ? stdout : `${stdout}\n`)
  // Only a failure writes to stderr: a real docker that succeeded says nothing there,
  // and a shim that always did would make every deploy log look like an incident.
  if (stderr && code !== 0) process.stderr.write(stderr.endsWith('\n') ? stderr : `${stderr}\n`)
  process.exit(code)
}

function behaviour(name) {
  return scenario.behaviour?.[name] ?? []
}

function seededContainer(name) {
  const seeded = scenario.containers?.[name]
  if (!seeded) return null
  return {
    id: seeded.id ?? `seeded-${name}`,
    labels: seeded.labels ?? {},
    status: seeded.status ?? 'running',
    pid: seeded.pid ?? 501,
    health: seeded.health ?? null,
    restartCount: seeded.restartCount ?? 0,
    image: seeded.image ?? scenario.image?.reference ?? 'apollo-video:unlabelled',
    networks: seeded.networks ?? { 'apollo-test-network': {} },
    hostConfig: seeded.hostConfig ?? { NanoCpus: 0, Memory: 0, MemorySwap: 0, PidsLimit: 0 },
    oomKilled: seeded.oomKilled === true,
    finishedAt: seeded.finishedAt ?? '0001-01-01T00:00:00Z',
  }
}

function container(name) {
  if (state.containers[name]) return state.containers[name]
  // A container this run removed stays removed: resurrecting it from the scenario
  // would make `docker rm` look like it silently failed.
  if ((state.removed ?? []).includes(name)) return null
  const seeded = seededContainer(name)
  if (seeded) {
    state.containers[name] = seeded
    saveState()
    return seeded
  }
  return null
}

// ---------------------------------------------------------------- delegated runs

// Only the short-lived `--rm` computations are delegated to real Node: the budget CLI
// and the verdict. The monitor is started detached and is NOT delegated — the test
// writes the samples and the gate itself, so the suite controls what the host "is".
function delegatedScript() {
  if (!argv.includes('--rm')) return null
  const index = argv.findIndex((value) => value.startsWith('scripts/ops/'))
  return index === -1 ? null : { script: argv[index], rest: argv.slice(index + 1) }
}

// Git Bash rewrites arguments that look like absolute Unix paths before handing them
// to a Windows program, so `/app/ops-state` can arrive as
// `C:/Program Files/Git/app/ops-state`. Matching on the suffix keeps the shim working
// on both platforms without the deploy script knowing anything about it.
function endsWithContainerPath(value, containerPath) {
  const normalized = String(value).replace(/\\/g, '/')
  return normalized === containerPath || normalized.endsWith(containerPath)
}

function translateStateDir(values) {
  return values.map((value) => (endsWithContainerPath(value, '/app/ops-state') ? hostStateDir : value))
}

function runDelegated(delegated) {
  const args = translateStateDir(delegated.rest)
  const approvedIndex = args.findIndex((value) => endsWithContainerPath(value, '/app/ops-budget/approved.json'))
  if (approvedIndex !== -1) args[approvedIndex] = process.env.APOLLO_RESOURCE_BUDGET_APPROVED_FILE ?? args[approvedIndex]
  const result = spawnSync(
    process.execPath,
    ['--disable-warning=MODULE_TYPELESS_PACKAGE_JSON', join(repositoryRoot, delegated.script), ...args],
    { encoding: 'utf8', cwd: repositoryRoot, env: { ...process.env, APOLLO_OPS_STATE_DIR: hostStateDir } },
  )
  record({ verb: 'run', delegated: delegated.script, exitCode: result.status })
  exit(result.status ?? 1, result.stdout ?? '', result.stderr ?? '')
}

// ------------------------------------------------------------------ inspect

function labelsOf(parsed) {
  const labels = {}
  for (const pair of parsed.labels) {
    const separator = pair.indexOf('=')
    if (separator === -1) continue
    labels[pair.slice(0, separator)] = pair.slice(separator + 1)
  }
  return labels
}

function formatContainer(target, format) {
  const health = target.health ?? null
  switch (format) {
    case '{{.State.Status}}':
      return target.status
    case '{{.State.Pid}}':
      return String(target.pid)
    case '{{.State.Running}}':
      return target.status === 'running' ? 'true' : 'false'
    case '{{.RestartCount}}':
      return String(target.restartCount)
    case '{{.Id}}':
      return target.id
    case '{{.State.Health.Status}}':
      return health ?? ''
    case '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}':
      return health ?? target.status
    case '{{.HostConfig.NanoCpus}}|{{.HostConfig.Memory}}|{{.HostConfig.MemorySwap}}|{{.HostConfig.PidsLimit}}':
      return [target.hostConfig.NanoCpus, target.hostConfig.Memory, target.hostConfig.MemorySwap, target.hostConfig.PidsLimit].join('|')
    case '{{index .Config.Labels "apollo.managed"}}|{{index .Config.Labels "apollo.role"}}|{{.Config.Image}}|{{.Id}}':
      return [target.labels['apollo.managed'] ?? '', target.labels['apollo.role'] ?? '', target.image, target.id].join('|')
    case '{{.Config.Image}}|{{range $name, $value := .NetworkSettings.Networks}}{{$name}} {{end}}':
      return `${target.image}|${Object.keys(target.networks).join(' ')} `
    case '{{.State.OOMKilled}}|{{.State.FinishedAt}}':
      return `${target.oomKilled === true ? 'true' : 'false'}|${target.finishedAt ?? '0001-01-01T00:00:00Z'}`
    default:
      // An unknown Go template must not silently print nothing: that is the exact
      // projection trap the deploy comments warn about.
      exit(1, '', `fake docker: unsupported inspect format ${format}`)
      return ''
  }
}

// ------------------------------------------------------------------ run parsing

function parseRun(values) {
  const parsed = { detached: false, remove: false, name: null, labels: [], limits: {}, command: [], envs: [] }
  let index = 0
  for (; index < values.length; index += 1) {
    const value = values[index]
    if (value === '-d') parsed.detached = true
    else if (value === '--rm') parsed.remove = true
    else if (value === '--name') parsed.name = values[++index]
    else if (value === '--label') parsed.labels.push(values[++index])
    else if (value === '--cpus') parsed.limits.cpus = values[++index]
    else if (value === '--memory') parsed.limits.memory = values[++index]
    else if (value === '--memory-swap') parsed.limits.memorySwap = values[++index]
    else if (value === '--pids-limit') parsed.limits.pids = values[++index]
    else if (value === '-e' || value === '--env') parsed.envs.push(values[++index])
    else if (value === '-v' || value === '--volume' || value === '--env-file' || value === '--network' || value === '--add-host' || value === '--restart') index += 1
    else if (value.startsWith('--health-')) index += 1
    else if (value === '--init') continue
    else if (value.startsWith('-')) index += 1
    else break
  }
  parsed.image = values[index]
  parsed.command = values.slice(index + 1)
  return parsed
}

function bytesOf(value) {
  if (!value) return 0
  return Number(String(value).replace(/b$/i, ''))
}

// ------------------------------------------------------------------ dispatch

const verb = argv[0]

if (verb === 'info') {
  record({ verb })
  const format = argv[argv.indexOf('--format') + 1]
  if (format === '{{.CgroupVersion}}|{{.CgroupDriver}}') {
    exit(0, `${scenario.cgroupVersion ?? '2'}|${scenario.cgroupDriver ?? 'systemd'}`)
  }
  exit(0, (scenario.infoWarnings ?? []).join('\n'))
}

if (verb === 'network') {
  record({ verb: 'network' })
  const name = argv[argv.length - 1]
  exit((scenario.networks ?? ['apollo-test-network']).includes(name) ? 0 : 1, '', `Error: No such network: ${name}`)
}

if (verb === 'image') {
  record({ verb: 'image inspect' })
  if (!scenario.image) exit(1, '', 'Error: No such image')
  const format = argv.includes('--format') ? argv[argv.indexOf('--format') + 1] : null
  if (format === '{{.Id}}') exit(0, scenario.image.id)
  if (format === '{{join .RepoDigests ","}}') exit(0, (scenario.image.repoDigests ?? []).join(','))
  exit(0, JSON.stringify([scenario.image]))
}

if (verb === 'inspect') {
  const format = argv.includes('--format') ? argv[argv.indexOf('--format') + 1] : null
  const name = argv[argv.length - 1]
  const target = container(name)
  record({ verb: 'inspect', name, format })
  if (!target) exit(1, '', `Error: No such object: ${name}`)
  if (!format) exit(0, JSON.stringify([{ Id: target.id }]))
  exit(0, formatContainer(target, format))
}

if (verb === 'run') {
  const parsed = parseRun(argv.slice(1))
  const delegated = delegatedScript()
  if (delegated) runDelegated(delegated)
  if (parsed.remove) {
    // config-check and migrate: answer what the real containers print.
    record({ verb: 'run --rm', name: parsed.name, command: parsed.command.join(' ') })
    if ((scenario.behaviour?.configCheckFails ?? false) && parsed.command.includes('node')) {
      exit(1, '', 'APOLLO_MEDIA_UPLOAD_SIGNING_SECRET must contain at least 32 characters')
    }
    if (parsed.command.some((value) => value.includes('db:v2:migrate:deploy'))) {
      if (scenario.behaviour?.migrateFails) exit(1, '', 'migration failed')
      exit(0, '')
    }
    exit(0, scenario.configCheckOutput ?? 'false|300000')
  }
  record({ verb: 'run -d', name: parsed.name, labels: parsed.labels, limits: parsed.limits, envs: parsed.envs })
  if (behaviour('runFails').includes(parsed.name)) exit(1, '', `Error: cannot start ${parsed.name}`)
  const mismatch = behaviour('readbackMismatch').includes(parsed.name)
  const cpus = Number(parsed.limits.cpus ?? 0)
  state.containers[parsed.name] = {
    id: `created-${parsed.name}-${state.nextPid}`,
    labels: labelsOf(parsed),
    status: 'running',
    pid: state.nextPid++,
    health: parsed.name === (scenario.appContainer ?? 'apollo-video') ? (behaviour('startUnhealthy').includes(parsed.name) ? 'unhealthy' : 'healthy') : null,
    restartCount: behaviour('restartLooping').includes(parsed.name) ? 3 : 0,
    image: parsed.image,
    networks: { 'apollo-test-network': {} },
    hostConfig: {
      NanoCpus: Math.round(cpus * 1e9) + (mismatch ? 1 : 0),
      Memory: bytesOf(parsed.limits.memory),
      MemorySwap: bytesOf(parsed.limits.memorySwap),
      PidsLimit: Number(parsed.limits.pids ?? 0),
    },
    oomKilled: false,
    finishedAt: '0001-01-01T00:00:00Z',
  }
  saveState()
  exit(0, state.containers[parsed.name].id)
}

if (verb === 'stop') {
  const name = argv[argv.length - 1]
  record({ verb: 'stop', name })
  const target = container(name)
  if (!target) exit(1, '', `Error: No such container: ${name}`)
  if (behaviour('stopFails').includes(name)) exit(1, '', `Error response from daemon: cannot stop ${name}`)
  if (behaviour('stopHangs').includes(name)) {
    // `docker stop` returns 0 after SIGKILL, and the container is still not in a
    // terminal state: the ambiguity the confirmation exists to catch.
    exit(0, name)
  }
  target.status = 'exited'
  target.pid = 0
  target.health = null
  saveState()
  exit(0, name)
}

if (verb === 'rm') {
  const name = argv[argv.length - 1]
  record({ verb: 'rm', name })
  if (behaviour('rmFails').includes(name)) exit(1, '', `Error response from daemon: cannot remove ${name}`)
  if (!container(name)) exit(1, '', `Error: No such container: ${name}`)
  delete state.containers[name]
  state.removed = [...(state.removed ?? []), name]
  saveState()
  exit(0, name)
}

if (verb === 'logs') {
  record({ verb: 'logs', name: argv[argv.length - 1] })
  exit(0, '')
}

record({ verb: verb ?? '<none>', unsupported: true })
exit(1, '', `fake docker: unsupported verb ${String(verb)}`)
