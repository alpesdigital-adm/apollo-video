FROM node:22-bookworm-slim AS node22
FROM mcr.microsoft.com/playwright:v1.62.0-noble
COPY --from=node22 /usr/local/bin/node /usr/local/bin/node
COPY --from=node22 /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends git openssl ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && browser='' \
    && for path in /ms-playwright/chromium-*/chrome-linux64/chrome /ms-playwright/chromium-*/chrome-linux/chrome; do \
         if test -x "$path"; then browser="$path"; break; fi; \
       done \
    && test -n "$browser" \
    && ln -s "$browser" /usr/local/bin/playwright-chromium \
    && node --version | grep '^v22[.]' \
    && npm --version \
    && ffmpeg -version >/dev/null
ENV CI=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PLAYWRIGHT_CHROME_EXECUTABLE=/usr/local/bin/playwright-chromium \
    APOLLO_V2_FFMPEG_PATH=/usr/bin/ffmpeg \
    APOLLO_FFMPEG_PATH=/usr/bin/ffmpeg \
    FFMPEG_PATH=/usr/bin/ffmpeg \
    APOLLO_FFPROBE_PATH=/usr/bin/ffprobe \
    FFPROBE_PATH=/usr/bin/ffprobe
