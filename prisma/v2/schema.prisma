  contaminationReports                   V2ContaminationReport[]
  contaminationObservations              V2ContaminationObservation[]
  contaminationProtectedRegions          V2ContaminationProtectedRegion[]
  contaminationFindings                  V2ContaminationFinding[]
  contaminationOverlaps                  V2ContaminationOverlap[]
  sourceCleanupPlans                     V2SourceCleanupPlan[]
  sourceCleanupResults                   V2SourceCleanupResult[]
  validationEnvelopeReuses               V2ValidationEnvelopeReuse[]
  validationEnvelopeDecisions            V2ValidationEnvelopeDecision[]
  proofNeedRuns                          V2ProofNeedRun[]
