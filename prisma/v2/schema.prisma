  variantPortfolioPolicies               V2VariantPortfolioPolicy[]
  variantPortfolioPreflights             V2VariantPortfolioPreflightRun[]
  batchEditPolicies                      V2BatchEditPolicy[]
  batchEditItemStates                    V2BatchEditItemStateVersion[]
  batchEditPreflights                    V2BatchEditPreflightRun[]
  batchEditCommands                      V2BatchEditCommand[]
  batchEditCommandItems                  V2BatchEditCommandItem[]
  batchEditInvalidations                 V2BatchEditInvalidation[]
  productionBatchRetryJobs               V2ProductionBatchRetryJob[]
  sourceDeconstructionReports            V2SourceDeconstructionReport[]
