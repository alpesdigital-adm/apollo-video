generator client {
  provider      = "prisma-client-js"
  output        = "../../generated/prisma-v2"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("V2_DATABASE_URL")
}

model V2Workspace {
