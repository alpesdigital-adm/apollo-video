  webhookAttempts                        V2WebhookDeliveryAttempt[]
  webhookChallenges                      V2WebhookVerificationChallenge[]
  webhookEndpointActivationLeases        V2WebhookEndpointActivationLease[]
  webhookReplayReceipts                  V2WebhookReplayReceipt[]
  editCommands                           V2EditCommand[]
  commandArtifactInvalidations           V2CommandArtifactInvalidation[]
  commandArtifactInvalidationResolutions V2CommandArtifactInvalidationResolution[]
  directorRuns                           V2DirectorRun[]
  reviewAnnotations                      V2ReviewAnnotation[]
  renderElementMaps                      V2RenderElementMap[]
  reviewPatchProposals                   V2ReviewPatchProposal[]
  reviewPatchBatches                     V2ReviewPatchBatch[]
  proxyReviews                           V2ProxyReview[]
  proxyReviewDecisions                   V2ProxyReviewDecision[]
  assetSelections                        V2AssetSelection[]
  qualityIterations                      V2QualityIteration[]
  mvpCoreGates                           V2MvpCoreGate[]
  speechCatalogRuns                      V2SpeechSegmentCatalogRun[]
  speechSegments                         V2SpeechSegment[]
  evidenceSegments                       V2EvidenceSegment[]
  longFormIndexRuns                      V2LongFormIndexRun[]
  longFormIndexWorkflows                 V2LongFormIndexWorkflow[]
  speakerDiarizationRuns                 V2SpeakerDiarizationRun[]
  speakerDiarizationSegments             V2SpeakerDiarizationSegment[]
  longFormChapters                       V2LongFormChapter[]
  longFormMoments                        V2LongFormMoment[]
  validatedSegments                      V2ValidatedSegment[]
  semanticSearchDocuments                V2SemanticSearchDocument[]
  retrievalEvaluations                   V2RetrievalEvaluation[]
  retrievalScaleEvaluations              V2RetrievalScaleEvaluation[]
  mediaColorProbes                       V2MediaColorProbe[]
  colorPipelineCompilations              V2ColorPipelineCompilation[]
  workspaceLuts                          V2WorkspaceLut[]
  workspaceLutVersions                   V2WorkspaceLutVersion[]
  workspaceLutStatusCommands             V2WorkspaceLutStatusCommand[]
